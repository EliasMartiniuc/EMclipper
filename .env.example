# ─── LLM Configuration ────────────────────────────────────────────────────────
LLM_PROVIDER=deepseek

# DeepSeek (Cloud) — get your API key at https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# ─── Whisper Transcription ─────────────────────────────────────────────────────
# Groq cloud API — get your API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ─── YouTube Downloader Proxy ───────────────────────────
# Required to bypass YouTube anti-bot checks on Render/AWS datacenters
PROXY_URL=

# ─── Subtitle Styling ─────────────────────────────────────────────────────────
SUBTITLE_FONT=Arial Black
SUBTITLE_FONTSIZE=62
# ASS color format: &HAABBGGRR (hex, note: BGR not RGB)
SUBTITLE_PRIMARY_COLOR=&H0000FFFF
SUBTITLE_SECONDARY_COLOR=&H00FFFFFF
SUBTITLE_OUTLINE_COLOR=&H00000000
SUBTITLE_BACK_COLOR=&H80000000
SUBTITLE_OUTLINE=4
SUBTITLE_SHADOW=2
SUBTITLE_MARGIN_V=180
SUBTITLE_WORDS_PER_LINE=4

# ─── Highlight Detection ──────────────────────────────────────────────────────
HIGHLIGHT_MIN_DURATION=20
HIGHLIGHT_MAX_DURATION=180
HIGHLIGHT_COUNT=3

# ─── YouTube ──────────────────────────────────────────────────────────────────
# Browser to extract cookies from for age-restricted videos (chrome, edge, firefox)
YOUTUBE_BROWSER=chrome

# ─── Supabase Configuration ───────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
ADMIN_EMAIL=your_admin_email@example.com
